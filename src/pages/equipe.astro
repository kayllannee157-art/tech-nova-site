
---
import LayoutBase from '../layouts/LayoutBase.astro';
import { empresa } from '../data/empresa.js';
---

<LayoutBase
  titulo="Nossa Equipe"
  descricao={`Conheça os profissionais por trás da ${empresa.nome}.`}
>
  <section>
    <h1>Nossa Equipe Técnica</h1>

    <p>
      Conheça os profissionais que transformam requisitos de negócio
      em soluções de software seguras e escaláveis.
    </p>

    <ul>
      <li>
        <h2>Kayllanne Eduarda</h2>
        <strong>Desenvolvedora de Software</strong>
        <p>
          Responsável por transformar ideias em soluções digitais.
          Atua no desenvolvimento de sistemas, na criação de funcionalidades
          e na busca por soluções tecnológicas que tornem as atividades
          do dia a dia mais simples e práticas.
        </p>
      </li>

      <li>
        <h2>Ketellyn Myrelly</h2>
        <strong>Designer e Desenvolvedora Front-end</strong>
        <p>
          Responsável pela parte visual e pela experiência dos usuários
          nas plataformas da empresa. Trabalha na criação de interfaces
          bonitas, organizadas e fáceis de utilizar, buscando unir
          criatividade e funcionalidade.
        </p>
      </li>

      <li>
        <h2>Pedro Avelar</h2>
        <strong>Analista de Projetos</strong>
        <p>
          Responsável por organizar e acompanhar os projetos da empresa.
          Atua no planejamento de tarefas, na organização de prazos
          e na comunicação da equipe.
        </p>
      </li>

      <li>
        <h2>Lucas Henrique</h2>
        <strong>Desenvolvedor Back-end</strong>
        <p>
          Responsável pela parte interna dos sistemas, trabalhando
          na organização dos dados, no funcionamento das funcionalidades
          e na segurança das aplicações.
        </p>
      </li>
    </ul>
  </section>
</LayoutBase>
